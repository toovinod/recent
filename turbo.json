{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PORT",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "WEB_ORIGIN",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "TWITTER_CLIENT_ID",
    "TWITTER_CLIENT_SECRET",
    "AUTH_COOKIE_DOMAIN",
    "NEXT_PUBLIC_CORE_URL",
    "CORE_INTERNAL_URL",
    "X_BEARER_TOKEN",
    "JEV_API_KEY",
    "OPENAI_API_KEY",
    "QUEUE_REDIS_URL",
    "CACHE_REDIS_URL",
    "ADMIN_USER_IDS",
    "MODEL_MONTHLY_BUDGET_USD",
    "MODEL_MONTHLY_REQUEST_LIMIT",
    "JEV_REQUEST_BUDGET_USD",
    "LUNA_REQUEST_BUDGET_USD",
    "X_MONTHLY_READ_LIMIT",
    "TEST_DATABASE_URL",
    "TEST_REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
